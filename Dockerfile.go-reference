ARG GO_VERSION=1.24.4
FROM golang:${GO_VERSION}-bookworm@sha256:10f549dc8489597aa7ed2b62008199bb96717f52a8e8434ea035d5b44368f8a6 AS builder

WORKDIR /app
COPY --from=go_reference backend/go.mod backend/go.sum ./backend/
WORKDIR /app/backend
RUN go mod download && go mod verify
WORKDIR /app
COPY --from=go_reference . .
WORKDIR /app/backend

RUN go build -v -o /run-app .

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS goose-downloader
ARG GOOSE_VERSION=v3.27.1
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
        amd64) asset_arch=x86_64; checksum=c5f1e5cd3b8e5da05592c2714b079d78ec846ddc7ec1f70d474c0449e79f6ab4 ;; \
        arm64) asset_arch=arm64; checksum=638af56b2ed33ff33cc3f30447f447b1c8e5894c6252fbda1e459adec94ba0fe ;; \
        *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --show-error --silent --location \
        "https://github.com/pressly/goose/releases/download/${GOOSE_VERSION}/goose_linux_${asset_arch}" \
        --output /goose \
    && echo "${checksum}  /goose" | sha256sum --check - \
    && chmod 0755 /goose

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS migrate
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=goose-downloader /goose /usr/local/bin/goose
COPY --from=go_reference backend/pkg/database/migrations /migrations
ENTRYPOINT ["/usr/local/bin/goose"]

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS runtime
WORKDIR /app
COPY --from=builder /run-app /usr/local/bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

CMD ["run-app"]
