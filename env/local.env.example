# Copy to env/local.env for a backend running on the host while its dependencies
# run through Docker Compose.
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://blog:blog@127.0.0.1:55432/blog
AUTH_SECRET=local-development-secret-replace-me
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=local-fixture-key
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
GROQ_API_KEY=local-fixture-key
GROQ_BASE_URL=http://127.0.0.1:8090/v1
EXA_API_KEY=local-fixture-key
EXA_BASE_URL=http://127.0.0.1:8090

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=blog
S3_ACCESS_KEY_SECRET=blog-local-secret
S3_BUCKET=blog
S3_URL_PREFIX=http://localhost:9000/blog

RUST_LOG=info
