# Copy to env/testing.env for explicitly selected, targeted host-side tests.
# This profile intentionally contains no production credentials.
DATABASE_URL=postgres://blog:blog@127.0.0.1:55433/blog_test
TEST_DATABASE_URL=postgres://blog:blog@127.0.0.1:55433/blog_test
TEST_S3_ENDPOINT=http://127.0.0.1:9000

AUTH_SECRET=local-test-secret-that-is-not-used-in-production
OPENAI_API_KEY=local-fixture-key
OPENAI_BASE_URL=http://127.0.0.1:8090/v1
GROQ_API_KEY=local-fixture-key
GROQ_BASE_URL=http://127.0.0.1:8090/v1
EXA_API_KEY=local-fixture-key
EXA_BASE_URL=http://127.0.0.1:8090

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=blog
S3_ACCESS_KEY_SECRET=blog-local-secret
S3_BUCKET=blog
S3_URL_PREFIX=http://localhost:9000/blog

RUST_LOG=info
